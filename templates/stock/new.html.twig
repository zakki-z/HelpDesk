{% extends 'base.html.twig' %}
{% block title %}Nouvel article — ONCF HelpDesk{% endblock %}
{% block page_title %}Nouvel article{% endblock %}
{% block body %}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card p-4">
            <h6 class="mb-4"><i class="bi bi-archive me-1"></i> Ajouter un article</h6>
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="mb-3">{{ form_row(form.nom_article) }}</div>
            <div class="row">
                <div class="col-6 mb-3">{{ form_row(form.quantite) }}</div>
                <div class="col-6 mb-3">{{ form_row(form.seuil_min) }}</div>
            </div>
            <div class="d-flex justify-content-between">
                <a href="{{ path('app_stock_index') }}" class="btn btn-outline-secondary">← Retour</a>
                <button type="submit" class="btn btn-oncf">Enregistrer</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
