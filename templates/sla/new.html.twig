{% extends 'base.html.twig' %}
{% block title %}Nouvelle règle SLA — ONCF HelpDesk{% endblock %}
{% block page_title %}Nouvelle règle SLA{% endblock %}
{% block body %}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card p-4">
            <h6 class="mb-4"><i class="bi bi-speedometer2 me-1"></i> Créer une règle SLA</h6>
            <div class="alert alert-info py-2" style="font-size:0.8rem;">
                <i class="bi bi-info-circle me-1"></i>
                Définissez les délais maximum acceptables pour répondre et résoudre un incident.
            </div>
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="mb-3">{{ form_row(form.temps_max_reponse) }}</div>
            <div class="mb-3">{{ form_row(form.temps_max_resolution) }}</div>
            <div class="d-flex justify-content-between">
                <a href="{{ path('app_sla_index') }}" class="btn btn-outline-secondary">← Retour</a>
                <button type="submit" class="btn btn-oncf">Enregistrer</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
