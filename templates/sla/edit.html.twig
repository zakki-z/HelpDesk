{% extends 'base.html.twig' %}
{% block title %}Modifier SLA #{{ sla.id }} — ONCF HelpDesk{% endblock %}
{% block page_title %}Modifier la règle SLA{% endblock %}
{% block body %}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card p-4">
            <h6 class="mb-4"><i class="bi bi-pencil me-1"></i> Modifier SLA #{{ sla.id }}</h6>
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="mb-3">{{ form_row(form.temps_max_reponse) }}</div>
            <div class="mb-3">{{ form_row(form.temps_max_resolution) }}</div>
            <div class="d-flex justify-content-between">
                <a href="{{ path('app_sla_index') }}" class="btn btn-outline-secondary">← Retour</a>
                <button type="submit" class="btn btn-oncf">Sauvegarder</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
