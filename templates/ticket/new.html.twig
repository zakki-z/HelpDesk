{% extends 'base.html.twig' %}

{% block title %}Nouveau ticket — ONCF HelpDesk{% endblock %}
{% block page_title %}Nouveau ticket{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card p-4">
            <h6 class="mb-4"><i class="bi bi-ticket-detailed me-1"></i> Signaler un problème</h6>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

            <div class="mb-3">{{ form_row(form.description) }}</div>

            <div class="row">
                <div class="col-md-6 mb-3">{{ form_row(form.priorite) }}</div>
                <div class="col-md-6 mb-3">{{ form_row(form.equipement) }}</div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">{{ form_row(form.panne) }}</div>
                <div class="col-md-6 mb-3">{{ form_row(form.sla) }}</div>
            </div>

            <div class="d-flex justify-content-between mt-2">
                <a href="{{ path('app_ticket_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Retour
                </a>
                <button type="submit" class="btn btn-accent">
                    <i class="bi bi-send me-1"></i> Soumettre le ticket
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
