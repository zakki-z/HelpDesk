{% extends 'base.html.twig' %}

{% block title %}Nouveau ticket — ONCF HelpDesk{% endblock %}
{% block page_title %}Nouveau ticket{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card p-4">
            <h6 class="mb-4"><i class="bi bi-ticket-detailed me-1"></i> Signaler un problème</h6>

            {# No novalidate — let browser + Symfony both validate #}
            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(form.priorite) }}
                    {{ form_widget(form.priorite) }}
                    {{ form_errors(form.priorite) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(form.equipement) }}
                    {{ form_widget(form.equipement) }}
                    {{ form_errors(form.equipement) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(form.panne) }}
                    {{ form_widget(form.panne) }}
                    {{ form_errors(form.panne) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(form.sla) }}
                    {{ form_widget(form.sla) }}
                    {{ form_errors(form.sla) }}
                </div>
            </div>

            <div class="d-flex justify-content-between mt-2">
                <a href="{{ path('app_ticket_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Retour
                </a>
                <button type="submit" class="btn btn-accent">
                    <i class="bi bi-send me-1"></i> Soumettre le ticket
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
