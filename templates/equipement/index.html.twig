{% extends 'base.html.twig' %}

{% block title %}Équipements — ONCF HelpDesk{% endblock %}
{% block page_title %}Gestion des équipements{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    {# Filters #}
    <form method="get" class="d-flex gap-2">
        <input type="text" name="q" value="{{ search }}" class="form-control form-control-sm"
               placeholder="Rechercher..." style="width:200px;">
        <select name="type" class="form-select form-select-sm" style="width:160px;" onchange="this.form.submit()">
            <option value="">Tous les types</option>
            {% for t in types %}
                <option value="{{ t }}" {{ current_type == t ? 'selected' }}>{{ t|capitalize }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="btn btn-sm btn-oncf"><i class="bi bi-search"></i></button>
    </form>

    {% if is_granted('ROLE_RESPONSABLE') %}
    <a href="{{ path('app_equipement_new') }}" class="btn btn-accent">
        <i class="bi bi-plus-lg me-1"></i> Nouvel équipement
    </a>
    {% endif %}
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead style="background: var(--oncf-light);">
                <tr>
                    <th style="font-size:0.8rem;">ID</th>
                    <th style="font-size:0.8rem;">Nom</th>
                    <th style="font-size:0.8rem;">Type</th>
                    <th style="font-size:0.8rem;">Tickets associés</th>
                    <th style="font-size:0.8rem; text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for e in equipements %}
                <tr>
                    <td style="font-size:0.85rem;">{{ e.id }}</td>
                    <td style="font-size:0.85rem;">{{ e.nom }}</td>
                    <td style="font-size:0.85rem;">
                        <span class="badge bg-light text-dark border">{{ e.type|capitalize }}</span>
                    </td>
                    <td style="font-size:0.85rem;">{{ e.tickets|length }}</td>
                    <td class="text-end">
                        <a href="{{ path('app_equipement_show', {id: e.id}) }}" class="btn btn-sm btn-outline-secondary" title="Voir">
                            <i class="bi bi-eye"></i>
                        </a>
                        {% if is_granted('ROLE_RESPONSABLE') %}
                        <a href="{{ path('app_equipement_edit', {id: e.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('app_equipement_delete', {id: e.id}) }}" class="d-inline"
                              onsubmit="return confirm('Supprimer cet équipement ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ e.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="bi bi-trash"></i></button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">Aucun équipement trouvé.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
