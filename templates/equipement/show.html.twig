{% extends 'base.html.twig' %}

{% block title %}{{ equipement.nom }} — ONCF HelpDesk{% endblock %}
{% block page_title %}Détail équipement{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="mb-1">{{ equipement.nom }}</h5>
                    <span class="badge bg-light text-dark border">{{ equipement.type|capitalize }}</span>
                </div>
                {% if is_granted('ROLE_RESPONSABLE') %}
                <a href="{{ path('app_equipement_edit', {id: equipement.id}) }}" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-pencil me-1"></i> Modifier
                </a>
                {% endif %}
            </div>

            <hr>

            <div class="row" style="font-size:0.9rem;">
                <div class="col-md-4 mb-3">
                    <div class="text-muted" style="font-size:0.75rem;">ID</div>
                    <div>{{ equipement.id }}</div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="text-muted" style="font-size:0.75rem;">Nom</div>
                    <div>{{ equipement.nom }}</div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="text-muted" style="font-size:0.75rem;">Type</div>
                    <div>{{ equipement.type|capitalize }}</div>
                </div>
            </div>

            {# Tickets liés #}
            <hr>
            <h6 class="text-muted mb-3" style="font-size:0.85rem;">Tickets associés ({{ equipement.tickets|length }})</h6>
            {% if equipement.tickets|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th style="font-size:0.8rem;">ID</th>
                                <th style="font-size:0.8rem;">Statut</th>
                                <th style="font-size:0.8rem;">Priorité</th>
                                <th style="font-size:0.8rem;">Date création</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ticket in equipement.tickets %}
                            <tr style="font-size:0.85rem;">
                                <td>#{{ ticket.id }}</td>
                                <td>{{ ticket.statut }}</td>
                                <td>{{ ticket.priorite }}</td>
                                <td>{{ ticket.dateCreation|date('d/m/Y H:i') }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="text-muted" style="font-size:0.85rem;">Aucun ticket associé à cet équipement.</p>
            {% endif %}

            {# Historique #}
            <hr>
            <h6 class="text-muted mb-3" style="font-size:0.85rem;">Historique des modifications ({{ equipement.historiques|length }})</h6>
            {% if equipement.historiques|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th style="font-size:0.8rem;">Date</th>
                                <th style="font-size:0.8rem;">Champ</th>
                                <th style="font-size:0.8rem;">Ancienne valeur</th>
                                <th style="font-size:0.8rem;">Nouvelle valeur</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for h in equipement.historiques %}
                            <tr style="font-size:0.85rem;">
                                <td>{{ h.dateModification|date('d/m/Y H:i') }}</td>
                                <td>{{ h.champModifie }}</td>
                                <td>{{ h.ancienneValeur }}</td>
                                <td>{{ h.nouvelleValeur }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="text-muted" style="font-size:0.85rem;">Aucun historique disponible.</p>
            {% endif %}

            <div class="mt-3">
                <a href="{{ path('app_equipement_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
