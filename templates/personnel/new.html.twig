{% extends 'base.html.twig' %}

{% block title %}Nouveau {{ type|capitalize }} — ONCF HelpDesk{% endblock %}
{% block page_title %}Nouveau {{ type }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-4">
            <h6 class="mb-3">
                <i class="bi bi-person-plus me-1"></i>
                Créer un {{ type }}
            </h6>

            {% include 'personnel/_form.html.twig' with {form: form, type: type, is_edit: false} %}
        </div>
    </div>
</div>
{% endblock %}
