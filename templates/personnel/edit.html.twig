{% extends 'base.html.twig' %}

{% block title %}Modifier {{ personnel.nomComplet }} — ONCF HelpDesk{% endblock %}
{% block page_title %}Modifier le personnel{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-4">
            <h6 class="mb-3">
                <i class="bi bi-pencil me-1"></i>
                Modifier : {{ personnel.nomComplet }}
            </h6>

            {% include 'personnel/_form.html.twig' with {form: form, type: type, is_edit: true} %}
        </div>
    </div>
</div>
{% endblock %}
