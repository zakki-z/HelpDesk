{% extends 'base.html.twig' %}

{% block title %}{{ personnel.nomComplet }} — ONCF HelpDesk{% endblock %}
{% block page_title %}Fiche personnel{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="mb-1">{{ personnel.nomComplet }}</h5>
                    <span class="text-muted" style="font-size:0.85rem;">{{ personnel.matricule }}</span>
                    {% if personnel is instanceof('App\\Entity\\Technicien') %}
                        <span class="badge bg-info badge-role ms-2">Technicien</span>
                    {% elseif personnel is instanceof('App\\Entity\\Responsable') %}
                        <span class="badge bg-warning text-dark badge-role ms-2">Responsable</span>
                    {% else %}
                        <span class="badge bg-secondary badge-role ms-2">Personnel</span>
                    {% endif %}
                </div>
                <div>
                    <a href="{{ path('app_personnel_edit', {id: personnel.id}) }}" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-pencil me-1"></i> Modifier
                    </a>
                </div>
            </div>

            <hr>

            <div class="row" style="font-size:0.9rem;">
                <div class="col-md-6 mb-3">
                    <div class="text-muted" style="font-size:0.75rem;">Email</div>
                    <div>{{ personnel.email }}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="text-muted" style="font-size:0.75rem;">Fonction</div>
                    <div>{{ personnel.fonction }}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="text-muted" style="font-size:0.75rem;">Date d'embauche</div>
                    <div>{{ personnel.dateEmbauche|date('d/m/Y') }}</div>
                </div>
            </div>

            {% if personnel is instanceof('App\\Entity\\Technicien') %}
            <hr>
            <h6 class="text-muted mb-3" style="font-size:0.85rem;">Détails technicien</h6>
            <div class="row" style="font-size:0.9rem;">
                <div class="col-md-4 mb-3">
                    <div class="text-muted" style="font-size:0.75rem;">Spécialité</div>
                    <div>{{ personnel.specialite }}</div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="text-muted" style="font-size:0.75rem;">Niveau</div>
                    <div>{{ personnel.niveauCompetence|capitalize }}</div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="text-muted" style="font-size:0.75rem;">Disponibilité</div>
                    <div>
                        {% if personnel.disponible %}
                            <span class="text-success"><i class="bi bi-check-circle"></i> Disponible</span>
                        {% else %}
                            <span class="text-danger"><i class="bi bi-x-circle"></i> Indisponible</span>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endif %}

            {% if personnel is instanceof('App\\Entity\\Responsable') %}
            <hr>
            <h6 class="text-muted mb-3" style="font-size:0.85rem;">Détails responsable</h6>
            <div class="row" style="font-size:0.9rem;">
                <div class="col-md-6 mb-3">
                    <div class="text-muted" style="font-size:0.75rem;">Service</div>
                    <div>{{ personnel.service }}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="text-muted" style="font-size:0.75rem;">Date de nomination</div>
                    <div>{{ personnel.dateNomination|date('d/m/Y') }}</div>
                </div>
            </div>
            {% endif %}

            <div class="mt-3">
                <a href="{{ path('app_personnel_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
