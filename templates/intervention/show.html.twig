{% extends 'base.html.twig' %}

{% block title %}Intervention #{{ intervention.id }} — ONCF HelpDesk{% endblock %}
{% block page_title %}Intervention #{{ intervention.id }}{% endblock %}

{% block body %}
<div class="row g-3">
    <div class="col-lg-8">

        {# Main card #}
        <div class="card p-4 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <span class="fw-semibold">Technicien : {{ intervention.technicien.nomComplet }}</span>
                    <div class="text-muted" style="font-size:0.8rem;">{{ intervention.technicien.specialite }}</div>
                </div>
                {% if intervention.isEnCours() %}
                    <span class="badge bg-success">En cours</span>
                {% else %}
                    <span class="badge bg-secondary">Clôturée — {{ intervention.getDureeHeures() }}h</span>
                {% endif %}
            </div>

            <div class="row" style="font-size:0.85rem;">
                <div class="col-md-6 mb-2">
                    <span class="text-muted">Début :</span> {{ intervention.dateDebut|date('d/m/Y à H:i') }}
                </div>
                <div class="col-md-6 mb-2">
                    <span class="text-muted">Fin :</span>
                    {{ intervention.dateFin ? intervention.dateFin|date('d/m/Y à H:i') : '—' }}
                </div>
            </div>

            {% if intervention.commentaire %}
            <div class="mt-2 p-3 rounded" style="background: var(--oncf-light); font-size:0.85rem;">
                {{ intervention.commentaire }}
            </div>
            {% endif %}
        </div>

        {# Parts used #}
        <div class="card p-3 mb-3">
            <div class="fw-semibold mb-3" style="font-size:0.83rem; color: var(--oncf-primary);">
                <i class="bi bi-box-seam me-1"></i> Pièces utilisées ({{ intervention.lignesIntervention|length }})
            </div>
            {% for ligne in intervention.lignesIntervention %}
            <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="font-size:0.83rem;">
                <span>{{ ligne.stock.nomArticle }}</span>
                <span class="badge bg-light text-dark border">× {{ ligne.quantiteUtilisee }}</span>
            </div>
            {% else %}
            <div class="text-muted text-center py-3" style="font-size:0.83rem;">Aucune pièce utilisée.</div>
            {% endfor %}

            {# Add part — only if in progress #}
            {% if intervention.isEnCours() and stocks|length > 0 %}
            <form method="post" action="{{ path('app_intervention_piece', {id: intervention.id}) }}" class="mt-3 d-flex gap-2 flex-wrap">
                <select name="stock_id" class="form-select form-select-sm" style="min-width:200px;">
                    <option value="">— Sélectionner une pièce —</option>
                    {% for s in stocks %}
                        <option value="{{ s.id }}" {{ s.quantite == 0 ? 'disabled' }}>
                            {{ s.nomArticle }} ({{ s.quantite }} en stock)
                        </option>
                    {% endfor %}
                </select>
                <input type="number" name="quantite" value="1" min="1" class="form-control form-control-sm" style="width:80px;">
                <button type="submit" class="btn btn-sm btn-oncf">
                    <i class="bi bi-plus-lg me-1"></i> Ajouter
                </button>
            </form>
            {% endif %}
        </div>

        {# Close intervention #}
        {% if intervention.isEnCours() %}
        <div class="card p-3 border-start border-warning border-3">
            <div class="fw-semibold mb-2" style="font-size:0.83rem;">Clôturer l'intervention</div>
            <form method="post" action="{{ path('app_intervention_cloturer', {id: intervention.id}) }}"
                  onsubmit="return confirm('Confirmer la clôture de cette intervention ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('cloturer' ~ intervention.id) }}">
                <div class="mb-2">
                    <textarea name="commentaire" class="form-control form-control-sm" rows="2"
                              placeholder="Commentaire de clôture (optionnel)..."></textarea>
                </div>
                <button type="submit" class="btn btn-sm btn-oncf">
                    <i class="bi bi-check-circle me-1"></i> Clôturer
                </button>
            </form>
        </div>
        {% endif %}
    </div>

    <div class="col-lg-4">
        <div class="card p-3 mb-3">
            <div class="fw-semibold mb-2" style="font-size:0.83rem; color: var(--oncf-primary);">
                <i class="bi bi-ticket-detailed me-1"></i> Ticket associé
            </div>
            <div style="font-size:0.83rem;">
                <div class="mb-1">
                    <a href="{{ path('app_ticket_show', {id: intervention.ticket.id}) }}" class="text-decoration-none fw-semibold">
                        Ticket #{{ intervention.ticket.id }}
                    </a>
                </div>
                <div class="mb-1">
                    <span class="badge statut-{{ intervention.ticket.statut }}">{{ intervention.ticket.getStatutLabel() }}</span>
                    <span class="badge priorite-{{ intervention.ticket.priorite }} ms-1">{{ intervention.ticket.getPrioriteLabel() }}</span>
                </div>
                <div class="text-muted mt-2" style="font-size:0.78rem;">
                    {{ intervention.ticket.description|slice(0, 120) }}{% if intervention.ticket.description|length > 120 %}…{% endif %}
                </div>
            </div>
        </div>

        <a href="{{ path('app_intervention_index') }}" class="btn btn-outline-secondary btn-sm w-100">
            <i class="bi bi-arrow-left me-1"></i> Retour aux interventions
        </a>
    </div>
</div>
{% endblock %}
